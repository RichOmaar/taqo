# Nexa — local monorepo configuration
#
# Copy this file to `.env` at the root (`cp .env.example .env`). That `.env` is
# git-ignored: it is yours, and it affects nobody else and no deploy.
#
#   pnpm dev            reads this file through dotenv-cli
#   docker compose      reads it automatically
#   pnpm test:e2e:web   reads it through playwright.config.ts
#
# The defaults live in packages/ports/src/defaults.ts and are the single source
# of truth; everything below only overrides them. A test fails if the two drift
# apart.

# ─────────────────────────────────────────────────────────────────────────────
# Ports — block reserved for Nexa: 9000-9999
#
# All of Nexa binds inside this block so it never collides with another project
# on the machine. Dev services take 9000-9099 and their e2e counterparts
# 9100-9199, so a dev stack can stay up while the tests run. 9229 is left free
# on purpose: it is Node's `--inspect` default.
# ─────────────────────────────────────────────────────────────────────────────

# Dev stack
NEXA_LANDING_PORT=9000
NEXA_CLIENT_PORT=9001
NEXA_RECEPTION_PORT=9002
NEXA_ADMIN_PORT=9003
NEXA_API_PORT=9010
NEXA_POSTGRES_PORT=9020

# E2E stack (Playwright and the backend e2e suite)
NEXA_E2E_CLIENT_PORT=9101
NEXA_E2E_RECEPTION_PORT=9102
NEXA_E2E_API_PORT=9110

# ─────────────────────────────────────────────────────────────────────────────
# Derived URLs
#
# In development these work themselves out from the ports above: move
# NEXA_API_PORT and the apps follow without you touching anything. Uncomment
# only to point at a backend that is not the local one (a QA environment, say).
# ─────────────────────────────────────────────────────────────────────────────

# NEXT_PUBLIC_API_URL=https://api.qa.nexa.app
# NEXT_PUBLIC_CLIENT_URL=https://app.qa.nexa.app

# ─────────────────────────────────────────────────────────────────────────────
# Database
#
# The port comes from NEXA_POSTGRES_PORT. Update this URL if you change it.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://nexa:nexa@localhost:9020/nexa

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — never commit these
# ─────────────────────────────────────────────────────────────────────────────

# At least 16 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Web push (VAPID). Optional: without these keys push is a no-op.
# Generate a pair with: pnpm --filter @nexa/api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@nexa.local
