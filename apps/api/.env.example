# apps/api — optional overrides
#
# The normal configuration (ports, DATABASE_URL, secrets) lives in the root
# `.env` of the monorepo: `cp .env.example .env` there and you are set.
# `pnpm dev` loads it.
#
# This file is only needed to make THIS app use something different from the
# rest. Copy it to `apps/api/.env` and uncomment what you need.
#
# Port precedence: NEXA_API_PORT (root) > API_PORT (here) > PORT (injected by
# the hosting platform on a deploy) > the default in packages/ports.

# NODE_ENV=development

# Override the port for the API alone, leaving the rest of the stack untouched.
# API_PORT=9010

# DATABASE_URL=postgresql://nexa:nexa@localhost:9020/nexa

# BETTER_AUTH_SECRET=replace-with-a-32+-char-random-secret
# BETTER_AUTH_URL=http://localhost:9010

# Origins BetterAuth accepts. Defaults to the dev ports of
# client/reception/admin, derived from packages/ports.
# TRUSTED_ORIGINS=http://localhost:9001,http://localhost:9002,http://localhost:9003

# Web push (VAPID) — generate with: pnpm --filter @nexa/api exec web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
