{
  "name": "@nexa/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:${NEXA_API_PORT:-9010}} NEXT_PUBLIC_CLIENT_URL=${NEXT_PUBLIC_CLIENT_URL:-http://localhost:${NEXA_CLIENT_PORT:-9001}} next dev --turbopack -p ${NEXA_ADMIN_PORT:-9003}'",
    "build": "next build",
    "start": "next start -p ${PORT:-9003}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexa/api-client": "workspace:*",
    "@nexa/ports": "workspace:*",
    "@nexa/types": "workspace:*",
    "@nexa/ui": "workspace:*",
    "next": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nexa/config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "catalog:",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
