# apps/admin — optional overrides
#
# Nothing is needed here in development: `pnpm dev` derives both URLs from the
# root `.env` of the monorepo (NEXA_API_PORT and NEXA_CLIENT_PORT). Copy this to
# `apps/admin/.env.local` only to point this app at a different environment.

# NEXT_PUBLIC_API_URL=https://api.qa.nexa.app

# Base of the link the panel's QR codes encode.
# NEXT_PUBLIC_CLIENT_URL=https://app.qa.nexa.app
