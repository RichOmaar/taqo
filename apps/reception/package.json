{
  "name": "@nexa/reception",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:${NEXA_API_PORT:-9010}} next dev --turbopack -p ${NEXA_RECEPTION_PORT:-9002}'",
    "build": "next build",
    "start": "next start -p ${PORT:-9002}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexa/api-client": "workspace:*",
    "@nexa/ports": "workspace:*",
    "@nexa/types": "workspace:*",
    "@nexa/ui": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nexa/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:"
  }
}
